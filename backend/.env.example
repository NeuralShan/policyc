# Copy to backend/.env and fill in. Every setting is optional except Gemini credentials.

# --- Gemini (via LangChain ChatGoogleGenerativeAI) ---
# "vertex" (recommended: enterprise data terms, region pinning) or "developer" (AI Studio key).
PC_GEMINI_BACKEND=vertex
PC_GCP_PROJECT=your-gcp-project-id
# Pin the region the documents are processed in, e.g. europe-west4 or asia-south1. Empty = SDK default.
PC_GCP_LOCATION=
# Optional API key. Without it, Vertex uses Application Default Credentials
# (run: gcloud auth application-default login).
# PC_GEMINI_API_KEY=

# Model tiers. Check what your project can use: uv run python -m app.core.llm.check --list-models
# On the FREE tier Pro models have zero quota: set PC_MODEL_PRO to a Flash model.
PC_MODEL_PRO=gemini-3.1-pro-preview
PC_MODEL_FLASH=gemini-3.8-flash
# Light tasks (document profiling). A separate model also means a separate free-tier quota.
PC_MODEL_LITE=gemini-3.5-flash-lite
PC_MODEL_EMBEDDING=gemini-embedding-2

# off | read_write | replay  (replay = cache only, a miss is an error; use in CI)
PC_LLM_CACHE_MODE=read_write
# Client-side throttle per model, requests per minute (0 = off). Free tier: keep it low, e.g. 8.
PC_LLM_MAX_RPM=0
# SDK retries on transient errors; daily-quota errors fail fast regardless.
# PC_LLM_MAX_RETRIES=2

# --- Ingestion (Layer 1) ---
# Docling model weights (~730 MB, downloaded on first PDF parse); keep inside the project.
# PC_MODELS_DIR=./models
# RapidOCR language for scanned pages, and the Gemini-vision second reading of OCR'd pages.
# PC_OCR_LANG=en
# PC_OCR_VISION_CHECK=true

# --- Storage (defaults: SQLite + files under backend/data) ---
# PC_DATA_DIR=./data
# PC_DATABASE_URL=sqlite:///./data/app.db
# PC_MAX_UPLOAD_MB=50

# --- Tracing (optional): LangChain picks these up automatically ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
