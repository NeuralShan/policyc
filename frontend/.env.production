# Copy to frontend/.env.production (or .env.local for dev) and fill in. Vite inlines these at build time.
# Backend origin (your Render service URL, no trailing slash). Leave empty in local dev
# (the Vite proxy forwards /api to 127.0.0.1:8000).
VITE_API_BASE=https://policyc-api.onrender.com

# Firebase web-app config (Firebase console > Project settings > Your apps). These are public
# identifiers, not secrets. Leave all unset to run with auth disabled.
VITE_FIREBASE_API_KEY=AIzaSyAFixZHvFNnDBfnqMisJwFc9FsSvIizT3o
VITE_FIREBASE_AUTH_DOMAIN=policyc-preprod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=policyc-preprod
VITE_FIREBASE_APP_ID=1:660149612773:web:71310cc08e08061d60640c
VITE_FIREBASE_MESSAGING_SENDER_ID=660149612773
